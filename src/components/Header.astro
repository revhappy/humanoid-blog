---
import { withBase } from '../lib/paths';
import { siteConfig } from '../lib/site';

// Public nav — Deals reserved for sponsors later (still valid in content schema)
const navItems = [
  { label: 'Humanoids', href: withBase('category/humanoids') },
  { label: 'Robotics', href: withBase('category/robotics') },
  { label: 'AI', href: withBase('category/ai') },
  { label: 'Research', href: withBase('category/research') },
  { label: 'Industry', href: withBase('category/industry') },
];

const currentPath = Astro.url.pathname;
---

<!-- Top utility bar -->
<div class="topbar">
  <div class="topbar__inner container">
    <div class="topbar__left">
      <span class="topbar__signal"></span>
      <span class="topbar__tagline">Tracking the rise of intelligent machines</span>
    </div>
    <div class="topbar__right">
      <a href={withBase('about')} class="topbar__link">About</a>
      <a href={withBase('contact')} class="topbar__link">Contact</a>
      <div class="topbar__social">
        {siteConfig.social.x && (
          <a href={siteConfig.social.x} aria-label="X (Twitter)" class="topbar__social-link" target="_blank" rel="noopener noreferrer">𝕏</a>
        )}
        {siteConfig.social.youtube && (
          <a href={siteConfig.social.youtube} aria-label="YouTube" class="topbar__social-link" target="_blank" rel="noopener noreferrer">YT</a>
        )}
        <a href={withBase('rss.xml')} aria-label="RSS Feed" class="topbar__social-link">RSS</a>
      </div>
    </div>
  </div>
</div>

<!-- Main header -->
<header class="header" id="site-header">
  <div class="header__inner container">
    <a href={withBase()} class="header__logo" aria-label={`${siteConfig.name} home`}>
      <span class="header__logo-icon">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="2" y="2" width="24" height="24" rx="4" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="10" cy="11" r="2" fill="var(--accent)"/>
          <circle cx="18" cy="11" r="2" fill="var(--accent)"/>
          <path d="M9 18C9 18 11 21 14 21C17 21 19 18 19 18" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="14" y1="4" x2="14" y2="7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </span>
      <span class="header__logo-text">MECHA<span class="header__logo-accent">FEED</span></span>
    </a>

    <nav class="header__nav" aria-label="Main navigation">
      {navItems.map(item => (
        <a
          href={item.href}
          class:list={['header__nav-link', { 'header__nav-link--active': currentPath.startsWith(item.href) }]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header__actions">
      <button class="header__menu-btn" aria-label="Menu" id="mobile-menu-toggle">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <!-- Mobile nav -->
  <div class="header__mobile-nav" id="mobile-nav">
    <nav>
      {navItems.map(item => (
        <a href={item.href} class="header__mobile-link">{item.label}</a>
      ))}
    </nav>
  </div>
</header>

<script>
  // Mobile menu toggle
  document.getElementById('mobile-menu-toggle')?.addEventListener('click', () => {
    document.getElementById('mobile-nav')?.classList.toggle('is-open');
    document.getElementById('mobile-menu-toggle')?.classList.toggle('is-active');
  });

  // Header scroll effect
  window.addEventListener('scroll', () => {
    const header = document.getElementById('site-header');
    if (window.scrollY > 100) {
      header?.classList.add('is-scrolled');
    } else {
      header?.classList.remove('is-scrolled');
    }
  });
</script>

<style>
  /* --- Top Bar --- */
  .topbar {
    height: var(--topbar-height);
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-subtle);
    position: sticky;
    top: 2px; /* below the accent glow line */
    z-index: 100;
  }

  .topbar__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .topbar__left {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .topbar__signal {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .topbar__tagline {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  .topbar__right {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .topbar__link {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    transition: color var(--duration-fast);
  }

  .topbar__link:hover { color: var(--text-primary); }

  .topbar__social {
    display: flex;
    gap: var(--space-sm);
  }

  .topbar__social-link {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    transition: all var(--duration-fast);
  }

  .topbar__social-link:hover {
    color: var(--accent);
    background: var(--accent-glow);
  }

  /* --- Header --- */
  .header {
    height: var(--header-height);
    background: rgba(11, 11, 20, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-subtle);
    position: sticky;
    top: calc(2px + var(--topbar-height));
    z-index: 99;
    transition: all var(--duration-normal) var(--ease-out);
  }

  .header.is-scrolled {
    background: rgba(7, 7, 13, 0.95);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);
  }

  .header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* --- Logo --- */
  .header__logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
    color: var(--text-primary);
    flex-shrink: 0;
  }

  .header__logo-icon {
    color: var(--text-primary);
    display: flex;
  }

  .header__logo-text {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.2rem;
    letter-spacing: 0.06em;
  }

  .header__logo-accent {
    color: var(--accent);
  }

  /* --- Nav --- */
  .header__nav {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .header__nav-link {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-sm);
    transition: all var(--duration-fast) var(--ease-out);
    position: relative;
  }

  .header__nav-link:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.03);
  }

  .header__nav-link--active {
    color: var(--accent);
  }

  .header__nav-link--active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 16px;
    height: 2px;
    background: var(--accent);
    border-radius: 1px;
  }

  /* --- Actions --- */
  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  /* --- Mobile Menu Button --- */
  .header__menu-btn {
    display: none;
    width: 40px;
    height: 40px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    background: transparent;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    cursor: pointer;
    padding: 0;
  }

  .header__menu-btn span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--text-secondary);
    border-radius: 1px;
    transition: all var(--duration-fast);
  }

  .header__menu-btn.is-active span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }
  .header__menu-btn.is-active span:nth-child(2) {
    opacity: 0;
  }
  .header__menu-btn.is-active span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  /* --- Mobile Nav --- */
  .header__mobile-nav {
    display: none;
    position: fixed;
    top: calc(2px + var(--topbar-height) + var(--header-height));
    left: 0;
    right: 0;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-subtle);
    padding: var(--space-lg);
    z-index: 98;
  }

  .header__mobile-nav.is-open {
    display: block;
  }

  .header__mobile-link {
    display: block;
    padding: var(--space-md) 0;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-secondary);
    border-bottom: 1px solid var(--border-subtle);
    transition: color var(--duration-fast);
  }

  .header__mobile-link:hover {
    color: var(--accent);
  }

  /* --- Responsive --- */
  @media (max-width: 900px) {
    .header__nav {
      display: none;
    }
    .header__menu-btn {
      display: flex;
    }
  }

  @media (max-width: 600px) {
    .topbar__right .topbar__link {
      display: none;
    }
    .topbar__tagline {
      font-size: 0.6rem;
    }
  }
</style>

---
import PageLayout from '../layouts/PageLayout.astro';
import { formSubmitAction, siteConfig } from '../lib/site';
import { withBase } from '../lib/paths';

const action = formSubmitAction(siteConfig.emails.contact);
const nextUrl = new URL(withBase('contact/?sent=1'), siteConfig.origin).href;
---

<PageLayout
  title="Contact"
  description="Tips, corrections, partnerships, and press. We read every message."
>
  <p>
    Story tips and corrections welcome. For advertising, see
    <a href={withBase('advertise')}>Advertise</a> or email
    <a href={`mailto:${siteConfig.emails.advertise}`}>{siteConfig.emails.advertise}</a>.
  </p>

  <p class="note">
    Forms currently deliver to <strong>{siteConfig.emails.contact}</strong> via FormSubmit.
    Replace this placeholder in <code>src/lib/site.ts</code>, then confirm the first email FormSubmit sends you.
  </p>

  <form class="contact-form" action={action} method="POST">
    <input type="hidden" name="_subject" value={`${siteConfig.name} contact form`} />
    <input type="hidden" name="_captcha" value="false" />
    <input type="hidden" name="_template" value="table" />
    <input type="hidden" name="_next" value={nextUrl} />
    <input type="text" name="_honey" class="contact-form__honey" tabindex="-1" autocomplete="off" />

    <label class="contact-form__field">
      <span>Name</span>
      <input type="text" name="name" required maxlength="120" />
    </label>

    <label class="contact-form__field">
      <span>Email</span>
      <input type="email" name="email" required maxlength="200" />
    </label>

    <label class="contact-form__field">
      <span>Subject</span>
      <input type="text" name="topic" required maxlength="200" placeholder="Tip, correction, press…" />
    </label>

    <label class="contact-form__field">
      <span>Message</span>
      <textarea name="message" required rows="6" maxlength="5000"></textarea>
    </label>

    <button type="submit" class="contact-form__submit">Send message</button>
  </form>

  <h2>Direct email</h2>
  <p>
    <a href={`mailto:${siteConfig.emails.contact}`}>{siteConfig.emails.contact}</a>
  </p>
</PageLayout>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin: var(--space-xl) 0;
  }

  .contact-form__honey {
    position: absolute;
    left: -9999px;
    opacity: 0;
    height: 0;
    width: 0;
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .contact-form__field span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .contact-form__field input,
  .contact-form__field textarea {
    background: var(--bg-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    padding: 0.75rem var(--space-md);
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--text-primary);
    outline: none;
    transition: border-color var(--duration-fast);
  }

  .contact-form__field input:focus,
  .contact-form__field textarea:focus {
    border-color: var(--accent);
  }

  .contact-form__field textarea {
    resize: vertical;
    min-height: 140px;
  }

  .contact-form__submit {
    align-self: flex-start;
    margin-top: var(--space-sm);
    padding: 0.75rem 1.5rem;
    background: var(--accent);
    border: none;
    border-radius: var(--radius-sm);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--bg-root);
    cursor: pointer;
    transition: background var(--duration-fast);
  }

  .contact-form__submit:hover {
    background: var(--accent-dim);
  }
</style>

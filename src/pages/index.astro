---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroArticle from '../components/HeroArticle.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { withBase } from '../lib/paths';
import { getPublishedPosts } from '../lib/posts';

// Newest first (pubDate, then file mtime for same-day ties).
const allPosts = await getPublishedPosts();

// Hero = manual `featured: true` if set, else the single newest post.
// (Daily rotation among top 5 made the homepage feel random.)
const manualFeatured = allPosts.find((p) => p.data.featured);
const featuredPost = manualFeatured ?? allPosts[0];
const remainingPosts = allPosts.filter((p) => p.id !== featuredPost?.id);

---

<BaseLayout title="Home">
  <div class="home container">
    <!-- Hero Featured Article -->
    <section class="home__hero" aria-label="Featured article">
      <HeroArticle
        title={featuredPost.data.title}
        description={featuredPost.data.description}
        slug={featuredPost.id}
        category={featuredPost.data.category}
        heroImage={featuredPost.data.heroImage}
        author={featuredPost.data.author}
        pubDate={featuredPost.data.pubDate}
      />
    </section>

    <!-- Main Content + Sidebar -->
    <div class="home__layout">
      <section class="home__main" aria-label="Latest articles">
        <div class="home__section-header">
          <h2 class="home__section-title">
            <span class="home__section-accent">//</span> Latest
            <span class="home__section-count">{remainingPosts.length}</span>
          </h2>
          <a href={withBase('category/humanoids')} class="home__view-all">Categories &rarr;</a>
        </div>

        {/* Full scroll feed — every non-hero article, newest first */}
        <div class="home__feed">
          {remainingPosts.map((post) => (
            <div class="home__feed-item">
              <ArticleCard
                title={post.data.title}
                description={post.data.description}
                slug={post.id}
                category={post.data.category}
                heroImage={post.data.heroImage}
                author={post.data.author}
                pubDate={post.data.pubDate}
                size="large"
              />
            </div>
          ))}
        </div>
      </section>

      <aside class="home__sidebar">
        <Sidebar />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .home {
    position: relative;
    z-index: 1;
    padding-bottom: var(--space-4xl);
    padding-top: var(--space-lg);
  }

  .home__hero {
    margin-bottom: var(--space-2xl);
  }

  .home__layout {
    display: grid;
    grid-template-columns: 1fr var(--sidebar-width);
    gap: var(--space-3xl);
    align-items: start;
  }

  .home__section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--border-subtle);
  }

  .home__section-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .home__section-accent {
    color: var(--accent);
    font-family: var(--font-mono);
    font-weight: 400;
  }

  .home__section-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
    margin-left: 0.15rem;
  }

  .home__view-all {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    transition: color var(--duration-fast);
  }

  .home__view-all:hover {
    color: var(--accent);
  }

  /* Continuous scroll feed of every article */
  .home__feed {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .home__feed-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .home__feed :global(.card) {
    width: 100%;
  }

  .home__sidebar {
    position: sticky;
    top: calc(var(--header-height) + var(--topbar-height) + var(--space-lg));
  }

  @media (max-width: 1100px) {
    .home__layout {
      grid-template-columns: 1fr;
    }
    .home__sidebar {
      position: static;
    }
  }
</style>

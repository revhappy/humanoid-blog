---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/paths';
import { absoluteUrl, siteConfig } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = siteConfig.description,
  ogImage,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage
  ? ogImage.startsWith('http')
    ? ogImage
    : absoluteUrl(ogImage.replace(/^\//, ''))
  : absoluteUrl('images/placeholder.svg');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
  <title>{title} | HUMANOID</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:url" content={canonicalUrl} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <!-- Google AdSense placeholder — replace with your actual ID -->
  <!-- <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX" crossorigin="anonymous"></script> -->

  <!-- Global Styles -->
  <link rel="stylesheet" href={withBase('global.css')} />

  <!-- RSS Feed (built on every deploy → dist/rss.xml) -->
  <link rel="alternate" type="application/rss+xml" title="HUMANOID Blog" href={withBase('rss.xml')} />
</head>
<body>
  <Header />
  <main id="main-content">
    <slot />
  </main>
  <Footer />

  <script>
    // Dark/Light mode toggle persistence
    const theme = localStorage.getItem('theme') || 'dark';
    document.documentElement.setAttribute('data-theme', theme);

    // Newsletter / form success flash from ?subscribed=1 or ?sent=1
    try {
      const params = new URLSearchParams(window.location.search);
      if (params.get('subscribed') === '1' || params.get('sent') === '1') {
        const bar = document.createElement('div');
        bar.setAttribute('role', 'status');
        bar.textContent =
          params.get('subscribed') === '1'
            ? 'Thanks — subscription request sent. Confirm FormSubmit if this is your first signup.'
            : 'Thanks — message sent.';
        bar.style.cssText =
          'position:fixed;bottom:1.25rem;left:50%;transform:translateX(-50%);z-index:300;max-width:min(92vw,28rem);padding:0.85rem 1.1rem;background:#141422;border:1px solid #00F0B5;border-radius:8px;color:#E2E2EC;font:500 0.85rem Outfit,sans-serif;box-shadow:0 8px 32px rgba(0,0,0,0.45);text-align:center;';
        document.body.appendChild(bar);
        setTimeout(() => bar.remove(), 6000);
        params.delete('subscribed');
        params.delete('sent');
        const clean = `${window.location.pathname}${params.toString() ? `?${params}` : ''}${window.location.hash}`;
        window.history.replaceState({}, '', clean);
      }
    } catch {
      /* ignore */
    }
  </script>
</body>
</html>
